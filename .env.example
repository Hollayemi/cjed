# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=
JWT_SECRET=

# Cloudinary: admin image uploads and volunteer CV uploads (Dashboard > Settings > API Keys).
# The secret stays on the server; the browser only gets a short-lived signature or posts to our own API.
# Note: in Cloudinary > Settings > Security, tick "Allow delivery of PDF and ZIP files",
# otherwise the CV links sent to the admin will not open.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo: emails the contact, partner and volunteer forms to the admin.
# BREVO_API_KEY: Brevo > SMTP & API > API Keys.
# BREVO_SENDER_EMAIL: must be a verified sender in Brevo (Senders, Domains & Dedicated IPs).
# ADMIN_NOTIFY_EMAIL: who receives the submissions. Separate several addresses with commas.
#                     Defaults to the email address in app/config/site.ts.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CJED Website
ADMIN_NOTIFY_EMAIL=
